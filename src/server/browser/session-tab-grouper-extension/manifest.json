{
  "manifest_version": 3,
  "name": "AI Web Test Session Tab Grouper",
  "version": "1.0.0",
  "description": "Groups AI Web Test browser-session tabs in Chrome's native tab strip.",
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": false,
      "match_about_blank": true
    }
  ]
}
