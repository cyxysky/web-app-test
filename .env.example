OPENAI_API_KEY=-
# Public host settings use ORBIT_*. Legacy WEBPILOT_* settings remain supported.
ORBIT_DEBUG_ROUTES_ENABLED=false
# Backend persistence. SQLite is the default and needs no external service.
DATABASE_DRIVER=sqlite
# Optional absolute SQLite path. Empty uses <APP_DATA_DIR>/.data/webpilot.db.
SQLITE_DATABASE_PATH=
# To use PostgreSQL, set DATABASE_DRIVER=postgres and uncomment DATABASE_URL.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/web_app_test
DATABASE_POOL_SIZE=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_LOGGING=false
DATABASE_BUSY_TIMEOUT_MS=5000
# 无头浏览器
HEADLESS_BROWSER=false
# 浏览器延迟
BROWSER_SLOW_MO_MS=0
# 是否是测试内容
AI_TEST_DEBUG=true
# 最大步数
AI_TEST_RUNTIME_MAX_STEPS=100

# Code Sandbox. Keep the main service on the remote runner in production.
AGENT_CODE_SANDBOX_ENABLED=false
AGENT_CODE_SANDBOX_BACKEND=remote
AGENT_CODE_SANDBOX_RUNNER_URL=http://webpilot-code-sandbox:18100
CODE_SANDBOX_RUNNER_TOKEN=replace-with-a-long-random-token
AGENT_CODE_SANDBOX_NETWORK_MODE=full
AGENT_CODE_SANDBOX_ALLOW_PACKAGE_INSTALL=true
AGENT_CODE_SANDBOX_MAX_PACKAGES=16
AGENT_CODE_SANDBOX_MAX_CONCURRENCY=2
AGENT_CODE_SANDBOX_MEMORY_MB=512
AGENT_CODE_SANDBOX_CPU_LIMIT=1
AGENT_CODE_SANDBOX_PIDS_LIMIT=128
AGENT_CODE_SANDBOX_WORKSPACE_MB=256
# 图像压缩大小
AI_SCREENSHOT_MAX_KB=20000
AI_PROVIDER=gemini
ORBIT_BASE_PATH=/orbit
# Default sidebar brand shown before a browser-specific value is saved in General settings.
ORBIT_BRAND_PREFIX=
ORBIT_BRAND_TEXT=Orbit
BROWSER_PREVIEW_TRANSPORT=video
BROWSER_PREVIEW_FPS=20
BROWSER_PREVIEW_VIDEO_BITRATE_KBPS=
BROWSER_PREVIEW_VIDEO_SOURCE_FORMAT=png
# 2K: 2560x1440; UHD 4K: 3840x2160; DCI 4K: 4096x2160.
BROWSER_PREVIEW_VIDEO_MAX_WIDTH=1920
BROWSER_PREVIEW_VIDEO_MAX_HEIGHT=1080
BROWSER_USER_BROWSER_IDLE_TIMEOUT_MS=180000
# Optional override. The bundled ffmpeg-static binary is used when empty.
FFMPEG_PATH=
# Local direct access uses this ID. Default: 1.
ORBIT_DEFAULT_USER_ID=1
# Online mounted deployments should require the ID supplied to Orbit.mount().
ORBIT_REQUIRE_MOUNT_USER_ID=false
# Set true only for a cross-site HTTPS iframe mount. This uses SameSite=None; Secure.
ORBIT_CROSS_SITE_MOUNT=false
# Optional: 15-120 seconds. Default: 45 seconds.
ORBIT_WEBSOCKET_TICKET_TTL_SECONDS=45
# Optional PDF font override for custom images without a bundled CJK font.
ORBIT_DOCUMENT_FONT=
ORBIT_DOCUMENT_FONT_FAMILY=
# Enable only when Orbit is reachable exclusively through a trusted reverse proxy.
ORBIT_TRUST_PROXY=false
ORBIT_ADMIN_SETTINGS_PASSWORD_ENABLED=true
ORBIT_ADMIN_SETTINGS_PASSWORD=123456

# GLiNER sensitive-data filtering for source development. Release installers
# and the Docker image bundle and configure this runtime automatically.
# Run `npm run sensitive-data:install` once before using the managed local dev runtime.
AI_SENSITIVE_DATA_FILTER_ENABLED=false
AI_SENSITIVE_DATA_FILTER_FAILURE_MODE=closed
AI_SENSITIVE_DATA_FILTER_TIMEOUT_MS=15000
AI_SENSITIVE_DATA_FILTER_THRESHOLD=0.5
AI_SENSITIVE_DATA_FILTER_LABELS=
GLINER_RUNTIME_MODE=auto
GLINER_SERVICE_URL=http://127.0.0.1:18001
GLINER_SERVICE_API_KEY=
GLINER_PYTHON_PATH=
GLINER_LOCAL_STARTUP_TIMEOUT_MS=600000
GLINER_MODEL=fastino/gliner2.5-multi-v1
# Internal second-stage boundary model. Official packages bundle it automatically.
GLINER_CHINESE_NER_MODEL=uer/roberta-base-finetuned-cluener2020-chinese
GLINER_DEVICE=cpu
GLINER_ENTITY_LABELS=
GLINER_BATCH_SIZE=8

# Context compaction: input trigger, soft target ratio, and small-Skill retention.
# These do not set provider generation/output limits.
AI_CONTEXT_COMPRESSION_TRIGGER_TOKENS=200000
AI_CONTEXT_COMPRESSION_TARGET_RATIO=0.25
AI_CONTEXT_SKILL_INLINE_TOKENS=2000
