# AI provider: openrouter, deepseek, or openai.
AI_PROVIDER=openrouter
AI_MODEL=qwen/qwen3.6-plus

# Fill the key for the selected provider.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=http://mirrors.shterm.com:8801/openai

# Browser runtime. Keep true for packaged/headless deployments.
HEADLESS_BROWSER=true
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800
BROWSER_SLOW_MO_MS=0

# Optional safety allowlist. Leave empty to allow http/https targets.
# ALLOWED_TEST_DOMAINS=localhost,127.0.0.1,example.com

# Optional AI/browser tuning.
SEND_SCREENSHOT_TO_AI=false
AI_TEST_REQUEST_TIMEOUT_MS=30000
AI_TEST_AGENT_MAX_STEPS=1
AI_TEST_RUNTIME_MAX_STEPS=30
MANUAL_VERIFICATION_TIMEOUT_MS=180000
SCREENSHOT_ELEMENT_LABELS=true
