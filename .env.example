OPENAI_API_KEY=-
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/web_app_test?schema=public"
# 无头浏览器
HEADLESS_BROWSER=false
# 浏览器延迟
BROWSER_SLOW_MO_MS=0
# 运行完毕后是否关闭浏览器
KEEP_BROWSER_OPEN_AFTER_RUN=false
# 是否是测试内容
AI_TEST_DEBUG=true
# 最大步数
AI_TEST_RUNTIME_MAX_STEPS=100
# 截图是否展示元素标签E
SCREENSHOT_ELEMENT_LABELS=true
VISUAL_MARKERS_IS_MARKED=true
VISUAL_MARKER_SEPARATE_MAP=false
# 元素标签E最大数量
SCREENSHOT_ELEMENT_LABEL_LIMIT=500
# 元素标签E最大数量
INTERACTIVE_CANDIDATE_LIMIT=500
# 是否是点击模型 visual-markers dom
AI_BROWSER_MODE=visual-markers
# 图像压缩大小
AI_SCREENSHOT_MAX_KB=20000
AI_PROVIDER=gemini
WEBPILOT_BASE_PATH=/webpilot
BROWSER_PREVIEW_TRANSPORT=video
BROWSER_PREVIEW_FPS=20
BROWSER_PREVIEW_VIDEO_BITRATE_KBPS=
BROWSER_PREVIEW_VIDEO_SOURCE_FORMAT=png
# 2K: 2560x1440; UHD 4K: 3840x2160; DCI 4K: 4096x2160.
BROWSER_PREVIEW_VIDEO_MAX_WIDTH=1920
BROWSER_PREVIEW_VIDEO_MAX_HEIGHT=1080
BROWSER_USER_BROWSER_IDLE_TIMEOUT_MS=600000
# Optional override. The bundled ffmpeg-static binary is used when empty.
FFMPEG_PATH=
WEBPILOT_DEFAULT_USER_ID=0
WEBPILOT_ADMIN_SETTINGS_PASSWORD_ENABLED=true
WEBPILOT_ADMIN_SETTINGS_PASSWORD=123456
