OPENAI_API_KEY=-
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/web_app_test?schema=public"
# 无头浏览器
HEADLESS_BROWSER=false
# 浏览器延迟
BROWSER_SLOW_MO_MS=250
# 运行完毕后是否关闭浏览器
KEEP_BROWSER_OPEN_AFTER_RUN=false
# 是否是测试内容
AI_TEST_DEBUG=true
# 最大步数
AI_TEST_RUNTIME_MAX_STEPS=50
# 截图是否展示元素标签E
SCREENSHOT_ELEMENT_LABELS=true
# 元素标签E最大数量
SCREENSHOT_ELEMENT_LABEL_LIMIT=300
# 元素标签E最大数量
INTERACTIVE_CANDIDATE_LIMIT=300
# 是否是点击模型
isClick=true