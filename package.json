{
  "name": "webpilot-qa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "node server/webpilot-server.js --dev",
    "build": "next build",
    "server:package": "npm run build && node scripts/package-server.js",
    "server:installer": "npm run server:package && node scripts/package-server-installer.js",
    "desktop:prepare": "npm run build && node scripts/prepare-electron-server.js",
    "desktop:pack": "npm run desktop:installer",
    "desktop:installer": "npm run desktop:prepare && electron-builder --win nsis",
    "desktop:portable": "npm run desktop:prepare && electron-builder --win portable",
    "start": "node server/webpilot-server.js",
    "check:responsive": "node scripts/check-responsive-ui.mjs",
    "docker:build": "docker build -t webpilot-qa:latest .",
    "docker:up": "docker compose up -d --build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:workflow": "vitest --config vitest.workflow.config.mts run"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^2.0.30",
    "@ai-sdk/amazon-bedrock": "^5.0.51",
    "@ai-sdk/anthropic": "^4.0.37",
    "@ai-sdk/azure": "^4.0.38",
    "@ai-sdk/cerebras": "^3.0.29",
    "@ai-sdk/cohere": "^4.0.26",
    "@ai-sdk/deepinfra": "^3.0.29",
    "@ai-sdk/deepseek": "^3.0.27",
    "@ai-sdk/fireworks": "^3.0.31",
    "@ai-sdk/gateway": "^4.0.47",
    "@ai-sdk/google": "^4.0.40",
    "@ai-sdk/groq": "^4.0.27",
    "@ai-sdk/huggingface": "^2.0.29",
    "@ai-sdk/mistral": "^4.0.28",
    "@ai-sdk/openai": "^4.0.37",
    "@ai-sdk/openai-compatible": "^3.0.29",
    "@ai-sdk/otel": "^1.0.59",
    "@ai-sdk/perplexity": "^4.0.28",
    "@ai-sdk/provider": "^4.0.7",
    "@ai-sdk/togetherai": "^3.0.30",
    "@ai-sdk/vercel": "^3.0.29",
    "@ai-sdk/workflow": "^1.0.59",
    "@ai-sdk/xai": "^4.0.34",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@open-file-viewer/core": "^0.1.42",
    "@open-file-viewer/react": "^0.1.42",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-virtual": "^3.14.3",
    "@workflow/serde": "^4.1.2",
    "ai": "^7.0.59",
    "ai-sdk-provider-codex-cli": "^2.1.2",
    "cfb": "^1.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.12.0",
    "motion": "^13.1.1",
    "next": "^16.3.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
    "playwright": "^1.60.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "workflow": "^4.7.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@workflow/vitest": "^4.0.15",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "eslint": "^9.27.0",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  },
  "build": {
    "appId": "com.webpilotqa.desktop",
    "productName": "WebPilot",
    "asar": true,
    "npmRebuild": true,
    "beforeBuild": "scripts/electron-before-build.js",
    "afterPack": "scripts/electron-after-pack.js",
    "directories": {
      "app": "electron",
      "output": "dist-electron"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "dist-desktop/server",
        "to": "server"
      },
      {
        "from": "assets/app-icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "assets/app-icon.ico",
        "to": "app-icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WebPilot-Setup-${version}-${arch}.${ext}",
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WebPilot",
      "runAfterFinish": true
    }
  }
}
