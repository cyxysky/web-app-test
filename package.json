{
  "name": "webpilot-qa",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "desktop:prepare": "npm run build && node scripts/prepare-electron-server.js",
    "desktop:pack": "npm run desktop:installer",
    "desktop:installer": "npm run desktop:prepare && electron-builder --win nsis",
    "desktop:portable": "npm run desktop:prepare && electron-builder --win portable",
    "start": "next start",
    "docker:build": "docker build -t webpilot-qa:latest .",
    "docker:up": "docker compose up -d --build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/azure": "^3.0.68",
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/openai": "^3.0.67",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@prisma/client": "^6.8.2",
    "@tinymce/tinymce-react": "^6.3.0",
    "ai": "^6.0.193",
    "ai-sdk-provider-codex-app-server": "^1.1.7",
    "ai-sdk-provider-codex-cli": "^1.2.1",
    "ai-sdk-provider-gemini-cli": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "playwright": "^1.60.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "tinymce": "^8.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.24",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "prisma": "^6.8.2",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.webpilotqa.desktop",
    "productName": "WebPilot QA",
    "asar": true,
    "npmRebuild": true,
    "beforeBuild": "scripts/electron-before-build.js",
    "afterPack": "scripts/electron-after-pack.js",
    "directories": {
      "app": "electron",
      "output": "dist-electron"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "dist-desktop/server",
        "to": "server"
      },
      {
        "from": "dist-desktop/tinymce",
        "to": "tinymce"
      },
      {
        "from": "assets/app-icon.png",
        "to": "app-icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WebPilot-QA-Setup-${version}-${arch}.${ext}",
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WebPilot QA",
      "runAfterFinish": true
    }
  }
}
