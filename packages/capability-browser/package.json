{
  "name": "@webpilot/capability-browser",
  "version": "0.1.0",
  "description": "Agent-framework-neutral Playwright browser capability and persistent browser-code runtime.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "runtime",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./runtime-skill": {
      "types": "./dist/runtime-skill.d.ts",
      "import": "./dist/runtime-skill.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "bin": {
    "webpilot-browser-mcp": "./dist/bin/mcp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@webpilot/capability-adapter-mcp": "0.1.0",
    "@webpilot/capability-sdk": "0.1.0",
    "acorn": "^8.16.0",
    "playwright": "^1.60.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.16"
  },
  "publishConfig": {
    "access": "public"
  }
}
