{
  "manifest_version": 3,
  "name": "Orbit Session Tab Grouper",
  "version": "1.0.0",
  "description": "Groups Orbit browser-session tabs in Chrome's native tab strip.",
  "icons": {
    "16": "icons/orbit-16.png",
    "32": "icons/orbit-32.png",
    "48": "icons/orbit-48.png",
    "128": "icons/orbit-128.png"
  },
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["group-title.js", "content-script.js"],
      "run_at": "document_start",
      "all_frames": false,
      "match_about_blank": true
    }
  ]
}
