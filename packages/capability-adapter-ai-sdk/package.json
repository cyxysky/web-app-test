{
  "name": "@webpilot/capability-adapter-ai-sdk",
  "version": "0.1.0",
  "description": "AI SDK adapter for framework-neutral Orbit capabilities.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./typeorm": {
      "types": "./dist/typeorm.d.ts",
      "import": "./dist/typeorm.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@webpilot/capability-host": "0.1.0",
    "@webpilot/capability-sdk": "0.1.0"
  },
  "peerDependencies": {
    "ai": ">=7.0.0 <8"
  },
  "engines": {
    "node": ">=22.16"
  },
  "publishConfig": {
    "access": "public"
  }
}
