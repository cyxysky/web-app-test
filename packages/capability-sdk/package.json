{
  "name": "@webpilot/capability-sdk",
  "version": "0.1.0",
  "description": "Framework-neutral capability contracts and runtime registry.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "FRAMEWORK_INTEGRATION.md"
  ],
  "exports": {
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.16"
  },
  "publishConfig": {
    "access": "public"
  }
}
