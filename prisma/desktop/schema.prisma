generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./.data/ai-web-test.db"
}

model TestCase {
  id                 String    @id
  groupId            String?
  title              String
  description        String
  targetUrl          String
  status             String    @default("draft")
  priority           String    @default("medium")
  contentJson        String
  imageNamesJson     String    @default("[]")
  strategyMemoryJson String    @default("[]")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  runs               TestRun[]
}

model TestRun {
  id          String   @id
  testCaseId  String
  status      String
  queueJson   String?
  startedAt   DateTime?
  endedAt     DateTime?
  resultJson  String?
  reportJson  String?
  analysisJson String?
  debugJson   String?
  controlJson String?
  createdAt   DateTime @default(now())
  testCase    TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  artifacts   Artifact[]

  @@index([testCaseId])
  @@index([status])
  @@index([createdAt])
}

model Artifact {
  id           String   @id
  runId        String
  type         String
  path         String
  title        String?
  metadataJson String?
  createdAt    DateTime @default(now())
  run          TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([type])
}

model TestGroup {
  id        String   @id
  parentId  String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model RuntimeEnv {
  key       String   @id
  value     String
  enabled   Boolean  @default(true)
  secret    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model ModelConfig {
  id        String   @id @default("default")
  provider  String
  configJson String
  updatedAt DateTime @updatedAt
}

model RunSchedule {
  id        String   @id
  name      String
  enabled   Boolean  @default(true)
  configJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreSnapshot {
  key       String   @id
  valueJson String
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrowserChatSession {
  id        String   @id
  valueJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}
