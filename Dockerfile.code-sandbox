FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin sandbox

WORKDIR /runner
COPY server/code-sandbox-runner.js ./code-sandbox-runner.js
RUN chown -R sandbox:sandbox /runner

ENV NODE_ENV=production \
    CODE_SANDBOX_RUNNER_HOST=0.0.0.0 \
    CODE_SANDBOX_RUNNER_PORT=18100 \
    CODE_SANDBOX_RUNNER_WORKSPACE=/tmp/webpilot-code-sandbox

EXPOSE 18100
CMD ["node", "/runner/code-sandbox-runner.js"]
